# Banco de dados (Turso em produção, arquivo local em dev)
DATABASE_URL=file:./local.db
DATABASE_AUTH_TOKEN=

# Senha de acesso à plataforma (defina algo forte!)
APP_PASSWORD=troque-esta-senha
# Segredo para assinar cookies de sessão (gere com: openssl rand -base64 32)
SESSION_SECRET=troque-este-segredo-com-32-bytes-aleatorios

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# Token cron — protege o endpoint do Vercel Cron
CRON_SECRET=troque-este-token

# Opcional: token padrão para popular o primeiro acesso
INITIAL_IG_ACCESS_TOKEN=
